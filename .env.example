# Copy to .env and fill in. Never commit .env.

# Claude API (scoring + summary tailoring)
ANTHROPIC_API_KEY=

# Telegram: token from @BotFather; chat id is read after you send /start to the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail: 2-step verification on, then Google Account > Security > App passwords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_ALERTS_LABEL=job-alerts
NOTIFY_EMAIL=you@gmail.com

# Google Sheet tracker: the id is the long part of the sheet URL (docs.google.com/spreadsheets/d/<id>/).
# Share the sheet with the service account email as Editor.
TRACKER_SHEET_ID=
# For Docker: put sa.json in secrets/ and leave this as-is (compose overrides it).
# For local dev: set this to the full host path of your JSON key file.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/sa.json

# Tuning (defaults; see CLAUDE.md open questions)
MATCH_THRESHOLD=60
DAILY_CARD_CAP=10
MAX_APPS_PER_COMPANY_30D=2
# Set to true for a dry run: fetch+score only, max 5 cards, no emails or sheet writes
DRY_RUN=false

# Scheduler (Israel time)
FETCH_TIMES=08:00,20:00
DIGEST_TIME=19:00
